<?xml version="1.0" encoding="UTF-8"?>
<QuickAction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Write a reply to the customer on this case. It is logged under Customer Messages and counts as the first response.</description>
    <fieldOverrides>
        <field>Name</field>
        <formula>&quot;Reply&quot;</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Type__c</field>
        <literalValue>Status Update</literalValue>
    </fieldOverrides>
    <fieldOverrides>
        <field>Channel__c</field>
        <literalValue>Email</literalValue>
    </fieldOverrides>
    <fieldOverrides>
        <field>Sent_At__c</field>
        <formula>NOW()</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Sent_By__c</field>
        <formula>$User.FirstName &amp; &quot; &quot; &amp; $User.LastName</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>Account__c</field>
        <formula>Case.AccountId</formula>
    </fieldOverrides>
    <label>Reply to Customer</label>
    <optionsCreateFeedItem>false</optionsCreateFeedItem>
    <quickActionLayout>
        <layoutSectionStyle>TwoColumnsLeftToRight</layoutSectionStyle>
        <quickActionLayoutColumns>
            <quickActionLayoutItems>
                <emptySpace>false</emptySpace>
                <field>Message_Text__c</field>
                <uiBehavior>Required</uiBehavior>
            </quickActionLayoutItems>
        </quickActionLayoutColumns>
        <quickActionLayoutColumns>
            <quickActionLayoutItems>
                <emptySpace>false</emptySpace>
                <field>Channel__c</field>
                <uiBehavior>Edit</uiBehavior>
            </quickActionLayoutItems>
        </quickActionLayoutColumns>
    </quickActionLayout>
    <successMessage>Reply logged under Customer Messages.</successMessage>
    <targetObject>Customer_Message__c</targetObject>
    <targetParentField>Case__c</targetParentField>
    <type>Create</type>
</QuickAction>
