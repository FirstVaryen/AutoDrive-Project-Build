<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CSAT_Score_1_To_10</fullName>
    <active>true</active>
    <description>US-22: a rating is a whole score from 1 to 10. Blank means unrated.</description>
    <errorConditionFormula>NOT(ISBLANK(CSAT_Score__c)) &amp;&amp; (CSAT_Score__c &lt; 1 || CSAT_Score__c &gt; 10 || CSAT_Score__c &lt;&gt; FLOOR(CSAT_Score__c))</errorConditionFormula>
    <errorDisplayField>CSAT_Score__c</errorDisplayField>
    <errorMessage>The satisfaction score must be a whole number from 1 to 10.</errorMessage>
</ValidationRule>
