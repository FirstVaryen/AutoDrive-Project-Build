<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Monthly_Instalment__c</fullName>
    <description>Instalment sales: amount due each month (amount on instalment divided by the duration).</description>
    <formula>IF(AND(ISPICKVAL(Payment_Mode__c, &quot;Instalment&quot;), Instalment_Term_Months__c &gt; 0), (Sale_Price__c - BLANKVALUE(Instalment_Down_Payment__c, 0)) / Instalment_Term_Months__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>AM Monthly Instalment</label>
    <precision>18</precision>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
