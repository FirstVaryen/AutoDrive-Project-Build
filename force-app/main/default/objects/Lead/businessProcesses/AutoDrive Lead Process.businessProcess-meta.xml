<?xml version="1.0" encoding="UTF-8"?>
<BusinessProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AutoDrive Lead Process</fullName>
    <description>AutoDrive lead statuses: New (recorded with phone or email), Contacted, then Converted (qualified: becomes a customer and sale) or Closed - Not Converted (dropped).</description>
    <isActive>true</isActive>
    <values>
        <fullName>New</fullName>
        <default>true</default>
    </values>
    <values>
        <fullName>Contacted</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Converted</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Closed - Not Converted</fullName>
        <default>false</default>
    </values>
</BusinessProcess>
