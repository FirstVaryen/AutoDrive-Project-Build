<!-- AutoDrive's New Lead: runs the "Lead - New Enquiry" flow instead of the standard form, so a
     returning or high-profile client shows a message rather than opening a lead the user can no longer see. -->
<aura:component implements="lightning:actionOverride" access="global">
    <lightning:navigation aura:id="nav" />
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <div class="slds-box slds-theme_default slds-m-around_medium">
        <lightning:flow aura:id="flow" onstatuschange="{!c.statusChange}" />
    </div>
</aura:component>
