<?xml version="1.0" encoding="UTF-8"?>
<PathAssistant xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <entityName>Opportunity</entityName>
    <fieldName>StageName</fieldName>
    <masterLabel>AutoDrive Sale Path</masterLabel>
    <pathAssistantSteps>
        <fieldNames>Vehicle__c</fieldNames>
        <fieldNames>Payment_Mode__c</fieldNames>
        <info>&lt;p&gt;Pick the vehicle the customer is viewing and how they plan to pay.&lt;/p&gt;</info>
        <picklistValueName>Viewing / Test Drive</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Vehicle__c</fieldNames>
        <fieldNames>List_Price__c</fieldNames>
        <fieldNames>Discount_Amount__c</fieldNames>
        <fieldNames>Sale_Price__c</fieldNames>
        <fieldNames>Payment_Mode__c</fieldNames>
        <info>&lt;p&gt;The offer: vehicle, price and payment mode. A discount goes through Discount Requests (5% or less is approved at once).&lt;/p&gt;</info>
        <picklistValueName>Offer</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Payment_Mode__c</fieldNames>
        <fieldNames>Instalment_Term_Months__c</fieldNames>
        <fieldNames>Instalment_Down_Payment__c</fieldNames>
        <fieldNames>Monthly_Instalment__c</fieldNames>
        <fieldNames>Down_Payment_Received__c</fieldNames>
        <info>&lt;p&gt;Full payment, or instalment: enter the duration (1-12 months) and the down payment agreed (30% or more); the monthly amount is worked out. Finance then clicks Create Instalment Plan, and the Head of Finance signs it off once the deposit is received.&lt;/p&gt;</info>
        <picklistValueName>Payment Arranged</picklistValueName>
    </pathAssistantSteps>
    <recordTypeName>AutoDrive_Sale</recordTypeName>
</PathAssistant>
