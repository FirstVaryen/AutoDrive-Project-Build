<?xml version="1.0" encoding="UTF-8"?>
<PathAssistant xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <entityName>Opportunity</entityName>
    <fieldName>StageName</fieldName>
    <masterLabel>AutoDrive Sale Path</masterLabel>
    <pathAssistantSteps>
        <fieldNames>Vehicle__c</fieldNames>
        <fieldNames>Vehicle_Model_Name__c</fieldNames>
        <fieldNames>Viewing_Date__c</fieldNames>
        <fieldNames>AccountId</fieldNames>
        <fieldNames>Customer_Type__c</fieldNames>
        <info>&lt;p&gt;Pick the car the customer is looking at and the viewing date.&lt;/p&gt;</info>
        <picklistValueName>Viewing / Test Drive</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>List_Price__c</fieldNames>
        <fieldNames>Sale_Price__c</fieldNames>
        <fieldNames>Payment_Mode__c</fieldNames>
        <fieldNames>Instalment_Term_Months__c</fieldNames>
        <fieldNames>Expected_Collection_Date__c</fieldNames>
        <info>&lt;p&gt;Agree the price and how they will pay. For instalments, the Showroom Manager sets the months (up to 12) and the deposit (at least 30%).&lt;/p&gt;</info>
        <picklistValueName>Offer</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Discount_Percent__c</fieldNames>
        <fieldNames>Pending_Discount_Requests__c</fieldNames>
        <fieldNames>Fleet_Rate_Applied__c</fieldNames>
        <fieldNames>Instalment_Down_Payment__c</fieldNames>
        <fieldNames>Monthly_Instalment__c</fieldNames>
        <info>&lt;p&gt;Discounts of 5% or less are approved at once; bigger ones need approval before you can move on. No discounts on an individual&apos;s instalment sale.&lt;/p&gt;</info>
        <picklistValueName>Payment Arranged</picklistValueName>
    </pathAssistantSteps>
    <recordTypeName>AutoDrive_Sale</recordTypeName>
</PathAssistant>
