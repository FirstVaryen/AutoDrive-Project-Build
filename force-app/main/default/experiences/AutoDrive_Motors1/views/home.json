      "components": [
        {
          "componentAttributes": {
            "richTextValue": "<div class=\"ad-section\">\n<p class=\"ad-eyebrow\">Buying with AutoDrive</p>\n<h2 class=\"ad-h2\">New vehicles, a clear process, and a team that follows up</h2>\n<div class=\"ad-cards\">\n<div class=\"ad-card\"><p class=\"ad-num\">1</p><h3>Choose your vehicle</h3><p>Send us an enquiry or visit the showroom. Our sales team confirms what is available on the day, so you never hear about a car that has already gone.</p></div>\n<div class=\"ad-card\"><p class=\"ad-num\">2</p><h3>Pick how you pay</h3><p>Full payment, or an instalment plan: a 30% down payment and the balance over up to 12 months, with a guarantor.</p></div>\n<div class=\"ad-card\"><p class=\"ad-num\">3</p><h3>We keep you updated</h3><p>Every payment is recorded and your balance is always up to date. You get an email reminder three days before each instalment is due.</p></div>\n</div>\n<div class=\"ad-strip\">\n<div><h3>Buying for a company?</h3><p>Fleet and corporate customers get one account, a named contact and an agreed discount rate, with several vehicles on one order.</p></div>\n<div><h3>Model not in stock?</h3><p>We can import it. You confirm by replying to your invoice, and we tell you as soon as the vehicle arrives.</p></div>\n</div>\n</div>"
          },
          "componentName": "forceCommunity:htmlBlock",
          "id": "ddaca8d4-f3b0-4d32-bada-be8b9851b251",
          "renderPriority": "NEUTRAL",
          "renditionMap": {},
          "type": "component"
        },
        {
          "componentAttributes": {
            "richTextValue": "<div class=\"ad-feature\"><div class=\"ad-feature-text\"><p class=\"ad-eyebrow\">The showroom</p><h2 class=\"ad-h2\">See it in person</h2><p>Every vehicle we sell is new, and the status you hear from us is the status in our system, updated the moment a car is sold.</p><p class=\"ad-points\">Full payment or 30% down over up to 12 months.</p></div></div>"
          },
          "componentName": "forceCommunity:htmlBlock",
          "id": "62c41b8c-60ff-4a49-b3ca-f3d12b28b1de",
