<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>AM Case Routing {!$Flow.CurrentDateTime}</interviewLabel>
    <description>Routes a new case by Type (Payment to Finance, Sales to Showroom, Technical to Customer Service; anything else to Customer Service for manual review) and gives it to that department queue, where Omni-Channel assigns it to an available person (US-06, US-11).</description>
    <label>AM Case - 4-Way Routing</label>
    <processType>AutoLaunchedFlow</processType>

    <assignments>
        <name>Route_To_Finance</name>
        <label>Route To Finance</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>$Record.Routed_To__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Finance</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_QueueName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>AD_Finance_Cases</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Queue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Route_To_Showroom</name>
        <label>Route To Showroom Manager</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>$Record.Routed_To__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Showroom Manager</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_QueueName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>AD_Showroom_Cases</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Queue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Route_To_Technical</name>
        <label>Route To Technical</label>
        <locationX>300</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>$Record.Routed_To__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Customer Service (Technical)</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_QueueName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Customer_Service</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Queue</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Route_To_Manual</name>
        <label>Route To Manual Review</label>
        <locationX>420</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>$Record.Routed_To__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Other</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_QueueName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Customer_Service</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Queue</targetReference>
        </connector>
    </assignments>

    <assignments>
        <name>Set_Queue_Owner</name>
        <label>Set Queue Owner</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Queue.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Queue_Found</name>
        <label>Queue Found?</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Queue_Owner</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_Routing</name>
        <label>Decide Routing</label>
        <locationX>176</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Route_To_Manual</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other / Documents</defaultConnectorLabel>
        <rules>
            <name>Is_Payment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Payment</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_To_Finance</targetReference>
            </connector>
            <label>Is Payment</label>
        </rules>
        <rules>
            <name>Is_Sales</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_To_Showroom</targetReference>
            </connector>
            <label>Is Sales</label>
        </rules>
        <rules>
            <name>Is_Technical</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Technical</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Route_To_Technical</targetReference>
            </connector>
            <label>Is Technical</label>
        </rules>
    </decisions>

    <recordLookups>
        <name>Get_Queue</name>
        <label>Get Queue</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Queue_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_QueueName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
        <connector>
            <targetReference>Decide_Routing</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>var_QueueName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
