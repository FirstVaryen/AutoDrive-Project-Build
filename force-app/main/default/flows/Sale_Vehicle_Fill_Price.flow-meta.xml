<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Set_Price</name>
        <label>Set Price</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Sale_Price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Vehicle__r.Model__r.List_Price__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Fleet sales: a vehicle added to the sale gets its model's list price (the Showroom Manager can change it).</description>
    <environments>Default</environments>
    <interviewLabel>Sale Vehicle Fill Price {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Sale Vehicle - Fill Price From Model</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Price</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK({!$Record.Vehicle__c})), OR(ISBLANK({!$Record.Sale_Price__c}), ISCHANGED({!$Record.Vehicle__c})))</filterFormula>
        <object>Sale_Vehicle__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>20</triggerOrder>
</Flow>
