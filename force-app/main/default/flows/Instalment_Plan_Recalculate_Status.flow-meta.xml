    <description>Works out an instalment plan's Plan Status for Finance: With Legal (open or in-progress escalation), else Defaulted, else Late, else Completed (nothing unpaid), else Active. Called by Instalment_Plan_Status_From_Instalment and Instalment_Plan_Status_From_Legal.</description>
    <environments>Default</environments>
    <interviewLabel>Instalment Plan Recalculate Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Instalment Plan - Recalculate Status</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Default_Instalment</name>
        <label>Get Default Instalment</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Late_Instalment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Instalment_Plan__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>planId</elementReference>
            </value>
        </filters>        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Instalment__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
