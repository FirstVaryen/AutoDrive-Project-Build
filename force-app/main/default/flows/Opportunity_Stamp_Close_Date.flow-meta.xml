<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Set_Close_Date_Today</name>
        <label>Set Close Date Today</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignmentItems>
            <assignToReference>$Record.CloseDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>When a sale is closed (won or lost), sets its Close Date to the day it was actually closed, so a sale can't be closed with a back-dated or future date. Closed_Deal_Locked then stops it changing.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Stamp Close Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Opportunity - Stamp Actual Close Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Close_Date_Today</targetReference>
        </connector>
        <filterFormula>AND(OR(ISNEW(), ISCHANGED({!$Record.StageName})), OR(ISPICKVAL({!$Record.StageName}, &quot;Closed Won&quot;), ISPICKVAL({!$Record.StageName}, &quot;Closed Lost&quot;)))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
