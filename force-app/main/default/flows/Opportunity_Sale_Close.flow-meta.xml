<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <interviewLabel>Opportunity Sale Close {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Opportunity Sale Close</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <description>US-01: when an Opportunity reaches Closed Won, sets its Vehicle's Status to Sold in the same transaction.</description>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Vehicle</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </filters>
    </start>

    <decisions>
        <name>Has_Vehicle</name>
        <label>Has Vehicle?</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <defaultConnectorLabel>No Vehicle</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Vehicle</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Vehicle__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Vehicle_Sold</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>

    <recordUpdates>
        <name>Mark_Vehicle_Sold</name>
        <label>Mark Vehicle Sold</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Vehicle__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Sold</stringValue>
            </value>
        </inputAssignments>
        <object>Vehicle__c</object>
    </recordUpdates>
</Flow>
