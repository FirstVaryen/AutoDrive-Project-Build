<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>AM Legal Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Legal Escalation - Raise (3-Gate)</label>
    <processType>Flow</processType>

    <actionCalls>
        <name>Notify_Legal_Team</name>
        <label>Notify Legal Team</label>
        <locationX>176</locationX>
        <locationY>700</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Done_Screen</targetReference>
        </connector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Label.AD_Email_Legal</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>New Legal Escalation Raised</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>var_NotifyBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>CurrentUser</stringValue>
            </value>
        </inputParameters>
    </actionCalls>

    <assignments>
        <name>Set_Gate_Variables</name>
        <label>Set Gate Variables</label>
        <locationX>176</locationX>
        <locationY>420</locationY>
        <assignmentItems>
            <assignToReference>var_GuarantorUnable</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Gate_Guarantor_Unable</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_FinanceApproved</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Gate_Finance_Approved</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_MonthsDefaulted</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Input_MonthsDefaulted</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_TotalOwed</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Input_TotalOwed</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Both_Gates_Confirmed</targetReference>
        </connector>
    </assignments>

    <decisions>
        <name>Check_90_Day_Gate</name>
        <label>Any Instalment 90+ Days Late?</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>No Qualifying Instalment</defaultConnectorLabel>
        <rules>
            <name>Found_90_Day_Instalment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Overdue_Instalment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirm_Gates_Screen</targetReference>
            </connector>
            <label>Found 90 Day Instalment</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Both_Gates_Confirmed</name>
        <label>Both Gates Confirmed?</label>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <defaultConnectorLabel>Not Both Confirmed</defaultConnectorLabel>
        <rules>
            <name>Both_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_GuarantorUnable</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_FinanceApproved</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Legal_Escalation</targetReference>
            </connector>
            <label>Both True</label>
        </rules>
    </decisions>

    <formulas>
        <name>var_NotifyBody</name>
        <dataType>String</dataType>
        <expression>"A new legal escalation has been raised for Instalment Plan " &amp; {!recordId} &amp; ". Months defaulted: " &amp; TEXT({!var_MonthsDefaulted}) &amp; ". Total amount owed: " &amp; TEXT({!var_TotalOwed}) &amp; ". Please review in Salesforce."</expression>
    </formulas>

    <recordCreates>
        <name>Create_Legal_Escalation</name>
        <label>Create Legal Escalation</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <connector>
            <targetReference>Notify_Legal_Team</targetReference>
        </connector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>Get_Instalment_Plan.Opportunity__r.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Instalment_Plan__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Guarantor_Information__c</field>
            <value>
                <elementReference>Get_Instalment_Plan.Guarantor__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Months_Defaulted__c</field>
            <value>
                <elementReference>var_MonthsDefaulted</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Total_Amount_Owed__c</field>
            <value>
                <elementReference>var_TotalOwed</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Escalated_By__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Escalated_On__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Legal_Team_Notified_At__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Note__c</field>
            <value>
                <stringValue>Raised via 3-gate Legal Escalation flow: 90+ day default confirmed by system, guarantor contacted and unable/unwilling to settle confirmed by user, Finance management approval confirmed by user.</stringValue>
            </value>
        </inputAssignments>
        <object>Legal_Escalation__c</object>
    </recordCreates>

    <recordLookups>
        <name>Get_Instalment_Plan</name>
        <label>Get Instalment Plan</label>
        <locationX>176</locationX>
        <locationY>100</locationY>
        <connector>
            <targetReference>Get_Overdue_Instalment</targetReference>
        </connector>
        <object>Instalment_Plan__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
    </recordLookups>
    <recordLookups>
        <name>Get_Overdue_Instalment</name>
        <label>Get Overdue Instalment</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <connector>
            <targetReference>Check_90_Day_Gate</targetReference>
        </connector>
        <object>Instalment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Instalment_Plan__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Days_Late__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>90.0</numberValue>
            </value>
        </filters>
    </recordLookups>

    <screens>
        <name>Confirm_Gates_Screen</name>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Enter_Details_Screen</targetReference>
        </connector>
        <fields>
            <name>Gate_Guarantor_Unable</name>
            <dataType>Boolean</dataType>
            <fieldText>Has the guarantor been contacted and confirmed unable or unwilling to settle?</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Gate_Finance_Approved</name>
            <dataType>Boolean</dataType>
            <fieldText>Has Finance management approved this escalation?</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <label>Confirm Escalation Gates</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Enter_Details_Screen</name>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Gate_Variables</targetReference>
        </connector>
        <fields>
            <name>Input_MonthsDefaulted</name>
            <dataType>Number</dataType>
            <fieldText>Months Defaulted</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_TotalOwed</name>
            <dataType>Currency</dataType>
            <fieldText>Total Amount Owed</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
        </fields>
        <label>Enter Escalation Details</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Done_Screen</name>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Done_Text</name>
            <fieldText>&lt;p&gt;Legal Escalation raised and the legal team has been notified by email.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <label>Escalation Raised</label>
        <locationX>176</locationX>
        <locationY>800</locationY>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Instalment_Plan</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_GuarantorUnable</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_FinanceApproved</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_MonthsDefaulted</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>var_TotalOwed</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
