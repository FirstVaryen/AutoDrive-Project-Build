    </assignments>
    <assignments>
        <name>Set_Type</name>
        <label>Set Type</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignmentItems>
            <assignToReference>$Record.Vehicle_Model__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_TypeId</elementReference>
            </value>
        </assignmentItems>
