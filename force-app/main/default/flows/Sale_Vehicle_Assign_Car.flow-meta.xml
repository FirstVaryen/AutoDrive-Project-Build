    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Type</targetReference>
        </connector>
        <filterFormula>AND(ISNEW(), OR(NOT(ISBLANK({!$Record.Vehicle_Model__c})), NOT(ISBLANK({!$Record.Vehicle__c}))))</filterFormula>
