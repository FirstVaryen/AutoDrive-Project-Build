        </connector>
    </assignments>
    <customErrors>
        <name>Not_Enough_Stock</name>
        <label>Not Enough Stock</label>
        <locationX>308</locationX>
        <locationY>647</locationY>
        <customErrorMessages>
            <errorMessage>{!f_ErrorText}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Car_Chosen</name>
        <label>Car Already Chosen?</label>
        <locationX>44</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Get_First</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Chosen</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Vehicle__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Enough_Stock</name>
        <label>Enough Stock?</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Not_Enough_Stock</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Enough</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_InStock</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_NeedOthers</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Car_Chosen</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Fleet sales: before a line is saved, its type is set (from the chosen car if only a car was picked), and the save is refused if fewer than How many cars of that type are Available (the rep is told to raise an Import Request). If no car was picked, the first available car of the type is put on the line with the type's list price (Sale_Vehicle_Add_Quantity adds the rest after save).</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ErrorText</name>
        <dataType>String</dataType>
        <expression>&quot;Not enough in stock: you asked for &quot; &amp; TEXT({!f_Wanted}) &amp; &quot; but only &quot; &amp; TEXT({!var_InStock} + IF(ISBLANK({!$Record.Vehicle__c}), 0, 1)) &amp; &quot; of this type are available. Nothing was added. Lower the number, or raise an Import Request for this type.&quot;</expression>
    </formulas>
    <formulas>
        <name>f_TypeId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Vehicle_Model__c}), {!$Record.Vehicle__r.Model__c}, {!$Record.Vehicle_Model__c})</expression>
    </formulas>
    <formulas>
        <name>f_NeedOthers</name>
        <dataType>Number</dataType>
        <expression>{!f_Wanted} - IF(ISBLANK({!$Record.Vehicle__c}), 0, 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Wanted</name>
        <dataType>Number</dataType>
        <expression>MAX(1, BLANKVALUE({!$Record.Quantity__c}, 1))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Sale Vehicle Assign Car {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Sale Vehicle - Assign Car Of Chosen Type</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
