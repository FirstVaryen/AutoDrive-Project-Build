<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Count_Stock</name>
        <label>Count Stock</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>var_InStock</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Available</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Enough_Stock</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Car</name>
        <label>Set Car</label>
        <locationX>44</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>$Record.Vehicle__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_First.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Sale_Price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Vehicle_Model__r.List_Price__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <name>Not_Enough_Stock</name>
        <label>Not Enough Stock</label>
        <locationX>308</locationX>
        <locationY>539</locationY>
        <customErrorMessages>
            <errorMessage>{!f_ErrorText}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Enough_Stock</name>
        <label>Enough Stock?</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Not_Enough_Stock</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Enough</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_InStock</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Wanted</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_First</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Fleet sales: the rep picks a type of car (Vehicle Model) and How many. Before the line is saved, the system checks that many cars of that type are Available; if not, the save is refused and the rep is told to raise an Import Request. If yes, the first available car is put on this line with the type's list price (Sale_Vehicle_Add_Quantity adds the rest after save).</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ErrorText</name>
        <dataType>String</dataType>
        <expression>&quot;Not enough in stock: you asked for &quot; &amp; TEXT({!f_Wanted}) &amp; &quot; &quot; &amp; {!$Record.Vehicle_Model__r.Name} &amp; &quot; but only &quot; &amp; TEXT({!var_InStock}) &amp; &quot; are available. Nothing was added. Lower the number, or raise an Import Request for this type.&quot;</expression>
    </formulas>
    <formulas>
        <name>f_Wanted</name>
        <dataType>Number</dataType>
        <expression>MAX(1, BLANKVALUE({!$Record.Quantity__c}, 1))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Sale Vehicle Assign Car {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Sale Vehicle - Assign Car Of Chosen Type</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Available</name>
        <label>Get Available</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Stock</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Model__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Vehicle_Model__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Available</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Vehicle__c</object>
        <queriedFields>Id</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_First</name>
        <label>Get First</label>
        <locationX>44</locationX>
        <locationY>500</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Car</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Model__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Vehicle_Model__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Available</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle__c</object>
        <queriedFields>Id</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Available</targetReference>
        </connector>
        <filterFormula>AND(ISNEW(), ISBLANK({!$Record.Vehicle__c}), NOT(ISBLANK({!$Record.Vehicle_Model__c})))</filterFormula>
        <object>Sale_Vehicle__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>10</triggerOrder>
    <variables>
        <name>var_InStock</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
