    <description>Finance: record a payment against an instalment. The amount still owed is filled in; change it for a short or extra payment (US-03, US-28). The payment is linked to the instalment and its sale.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_PayName</name>
        <dataType>String</dataType>
