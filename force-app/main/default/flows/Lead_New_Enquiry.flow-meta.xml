    <decisions>
        <name>Missing_Details</name>
        <label>Missing Details?</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <defaultConnector>
            <targetReference>Has_Phone_Or_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All there</defaultConnectorLabel>
        <rules>
            <name>Yes_Missing</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>var_Lead.Company</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_Lead.Channel__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_Lead.Customer_Type__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Fill_In</targetReference>
            </connector>
            <label>Missing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Phone_Or_Email</name>
        <label>Has Phone Or Email?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Create_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Neither</defaultConnectorLabel>
        <rules>
            <name>Yes_Contact_Details</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>var_Lead.Phone</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_Lead.Email</leftValueReference>
