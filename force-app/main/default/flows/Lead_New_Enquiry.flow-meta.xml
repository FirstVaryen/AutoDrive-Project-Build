        </rules>
    </decisions>
    <decisions>
        <name>Is_Duplicate</name>
        <label>Is Duplicate?</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Create_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No match</defaultConnectorLabel>
        <rules>
            <name>Match_Found</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Find_Matching_Lead.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Find_Matching_Contact.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Possible_Duplicate</targetReference>
            </connector>
            <label>Match found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Save_Anyway</name>
        <label>Save Anyway?</label>
        <locationX>176</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Enquiry_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Go back</defaultConnectorLabel>
        <rules>
            <name>Yes_Save</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Duplicate_Choice</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>save</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Lead</targetReference>
            </connector>
            <label>Save</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_High_Profile</name>
        <label>Is High Profile?</label>
        <locationX>176</locationX>
        <locationY>998</locationY>
        <defaultConnector>
            <targetReference>Get_New_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Standard</defaultConnectorLabel>
        <rules>
            <name>Yes_High_Profile</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>var_Lead.Returning_or_High_profile__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>var_Lead.Channel__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Returning/High-profile</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_High_Profile</targetReference>
            </connector>
            <label>High profile</label>
        </rules>
    </decisions>
    <description>AutoDrive's New Lead form (replaces the standard New). Same fields, warns about an existing customer with the same phone or email, then saves. A returning or high-profile client shows a message that they have been passed to the Showroom Manager instead of opening a record the person can no longer see (US-23, US-30).</description>
    <environments>Default</environments>
    <formulas>
        <name>f_Name</name>
        <dataType>String</dataType>
        <expression>TRIM(BLANKVALUE({!var_Lead.FirstName}, &quot;&quot;) &amp; &quot; &quot; &amp; {!var_Lead.LastName})</expression>
    </formulas>
    <interviewLabel>Lead New Enquiry {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>AM Lead - New Enquiry</label>
    <processMetadataValues>
