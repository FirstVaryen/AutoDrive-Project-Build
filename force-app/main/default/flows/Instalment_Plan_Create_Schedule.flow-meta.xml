<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Add_Instalment</name>
        <label>Add Instalment</label>
        <locationX>264</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>var_Count</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Inst.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_InstName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Inst.Instalment_Plan__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Inst.Amount_Due__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_Monthly</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Inst.Due_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_DueDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Inst.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Upcoming</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Insts</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_Inst</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>More_Months</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>More_Months</name>
        <label>More Months?</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Create_Schedule</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Done</defaultConnectorLabel>
        <rules>
            <name>Yes_More</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Count</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Record.Term_in_Months__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Instalment</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>US-03 / US-15 / US-29: when Finance creates an instalment plan, its monthly schedule is created at once: one instalment per month for the plan's term, each due one month after the last, for (sale price - down payment) / months.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_DueDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Flow.CurrentDate}, {!var_Count})</expression>
    </formulas>
    <formulas>
        <name>f_InstName</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.Opportunity__r.Account.Name}, {!$Record.Opportunity__r.Name}) &amp; &quot; - Month &quot; &amp; TEXT({!var_Count}) &amp; &quot; of &quot; &amp; TEXT({!$Record.Term_in_Months__c})</expression>
    </formulas>
    <formulas>
        <name>f_Monthly</name>
        <dataType>Currency</dataType>
        <expression>IF({!var_Count} = {!$Record.Term_in_Months__c}, (BLANKVALUE({!$Record.Opportunity__r.Sale_Price__c}, 0) - BLANKVALUE({!$Record.Down_Payment_Amount__c}, 0)) - ROUND((BLANKVALUE({!$Record.Opportunity__r.Sale_Price__c}, 0) - BLANKVALUE({!$Record.Down_Payment_Amount__c}, 0)) / {!$Record.Term_in_Months__c}, 2) * ({!$Record.Term_in_Months__c} - 1), ROUND((BLANKVALUE({!$Record.Opportunity__r.Sale_Price__c}, 0) - BLANKVALUE({!$Record.Down_Payment_Amount__c}, 0)) / {!$Record.Term_in_Months__c}, 2))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Instalment Plan Create Schedule {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Instalment Plan - Create Monthly Schedule</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Schedule</name>
        <label>Create Schedule</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <inputReference>var_Insts</inputReference>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>More_Months</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK({!$Record.Term_in_Months__c})), {!$Record.Term_in_Months__c} &gt; 0)</filterFormula>
        <object>Instalment_Plan__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_Count</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>var_Inst</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Instalment__c</objectType>
    </variables>
    <variables>
        <name>var_Insts</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Instalment__c</objectType>
    </variables>
</Flow>
