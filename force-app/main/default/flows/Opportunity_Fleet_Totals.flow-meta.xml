<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Set_Fleet_Prices</name>
        <label>Set Fleet Prices</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.List_Price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Fleet_Vehicles_Total__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Sale_Price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_SalePrice</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Fleet sales: the sale's List Price is the total of all cars on its Fleet Vehicles list, and the Sale Price is that total minus any approved discount, so the sale always reflects every car on it.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_SalePrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Fleet_Vehicles_Total__c} - BLANKVALUE({!$Record.Discount_Amount__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Opportunity Fleet Totals {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Opportunity - Fleet Sale Price From Fleet Total</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Fleet_Prices</targetReference>
        </connector>
        <filterFormula>AND(NOT({!$Record.IsClosed}), {!$Record.Account.RecordType.DeveloperName} = &quot;Fleet_Corporate&quot;, {!$Record.Fleet_Vehicle_Count__c} &gt; 0)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>15</triggerOrder>
</Flow>
