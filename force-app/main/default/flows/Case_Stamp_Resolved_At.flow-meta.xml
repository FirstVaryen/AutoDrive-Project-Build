<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Stamp_Resolved_At</name>
        <label>Stamp Resolved At</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignmentItems>
            <assignToReference>$Record.Resolved_At__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Stamps Case.Resolved_At__c the first time a case is closed (KAN-64). A reopened and re-closed case keeps its first resolution time.</description>
    <environments>Default</environments>
    <interviewLabel>Case Stamp Resolved At {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Case - Stamp Resolved At</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Resolved_At</targetReference>
        </connector>
        <filterFormula>AND(ISPICKVAL({!$Record.Status}, &quot;Closed&quot;), ISBLANK({!$Record.Resolved_At__c}))</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
