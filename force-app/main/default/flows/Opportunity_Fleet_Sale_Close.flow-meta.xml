<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Add_Vehicle_To_Update</name>
        <label>Add Vehicle To Update</label>
        <locationX>264</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>var_Vehicle.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Sale_Vehicles.Vehicle__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Vehicle.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Sold</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_VehiclesToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_Vehicle</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Sale_Vehicles</targetReference>
        </connector>
    </assignments>
    <description>When a fleet sale closes Won, marks every vehicle on it (Sale Vehicles) as Sold, the same as Opportunity_Sale_Close does for an individual sale's single vehicle (US-01).</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Fleet Sale Close {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Opportunity - Fleet Sale Close (Vehicles Sold)</label>
    <loops>
        <name>Loop_Sale_Vehicles</name>
        <label>Loop Sale Vehicles</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <collectionReference>Get_Sale_Vehicles</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Vehicle_To_Update</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Mark_Vehicles_Sold</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Sale_Vehicles</name>
        <label>Get Sale Vehicles</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Sale_Vehicles</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Sale_Vehicle__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Vehicle__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Mark_Vehicles_Sold</name>
        <label>Mark Vehicles Sold</label>
        <locationX>176</locationX>
        <locationY>623</locationY>
        <inputReference>var_VehiclesToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Sale_Vehicles</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.StageName}), ISPICKVAL({!$Record.StageName}, &quot;Closed Won&quot;), {!$Record.Fleet_Vehicle_Count__c} &gt; 0)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_Vehicle</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Vehicle__c</objectType>
    </variables>
    <variables>
        <name>var_VehiclesToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Vehicle__c</objectType>
    </variables>
</Flow>
