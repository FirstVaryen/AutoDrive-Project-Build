<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>Fleet sales: after a line is saved with How many above 1 (stock already checked by Sale_Vehicle_Assign_Car), the line's car is reserved and (How many - 1) more available cars of the same type are added through Add_Fleet_Vehicles_Core; the line is then set back to 1 because every car has its own line.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_More</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Quantity__c} - 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Sale Vehicle Add Quantity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Sale Vehicle - Add Quantity Of Same Model</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Reserve_Chosen_Car</name>
        <label>Reserve Chosen Car</label>
        <locationX>44</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Add_More</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Vehicle__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Reserved</stringValue>
            </value>
        </inputAssignments>
        <object>Vehicle__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Reset_Line</name>
        <label>Reset Line</label>
        <locationX>44</locationX>
        <locationY>755</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Quantity__c</field>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <object>Sale_Vehicle__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reserve_Chosen_Car</targetReference>
        </connector>
        <filterFormula>AND(ISNEW(), {!$Record.Quantity__c} &gt; 1, NOT(ISBLANK({!$Record.Vehicle__c})), NOT(ISBLANK({!$Record.Vehicle_Model__c})))</filterFormula>
        <object>Sale_Vehicle__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Add_More</name>
        <label>Add More</label>
        <locationX>44</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Reset_Line</targetReference>
        </connector>
        <flowName>Add_Fleet_Vehicles_Core</flowName>
        <inputAssignments>
            <name>modelId</name>
            <value>
                <elementReference>$Record.Vehicle_Model__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>quantity</name>
            <value>
                <elementReference>f_More</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
