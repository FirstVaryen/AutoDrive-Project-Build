<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Count_Others</name>
        <label>Count Others</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>var_Others</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Other_Available</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Enough_Stock</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Not_Enough_Stock</name>
        <label>Not Enough Stock</label>
        <locationX>308</locationX>
        <locationY>539</locationY>
        <customErrorMessages>
            <errorMessage>{!f_ErrorText}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Enough_Stock</name>
        <label>Enough Stock?</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Not_Enough_Stock</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Enough</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Others</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_More</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reserve_Chosen_Car</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Fleet sales: when a vehicle line is saved with How many above 1, the save is refused if the showroom does not have that many of the model in stock (the rep is told to raise an Import Request instead). If there are enough, the chosen car is reserved and (How many - 1) more available cars of the same model are added through Add_Fleet_Vehicles_Core; the line is then set back to 1 because every car has its own line.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ErrorText</name>
        <dataType>String</dataType>
        <expression>&quot;Not enough in stock: you asked for &quot; &amp; TEXT({!$Record.Quantity__c}) &amp; &quot; &quot; &amp; {!$Record.Vehicle__r.Model__r.Name} &amp; &quot; but only &quot; &amp; TEXT({!var_Others} + 1) &amp; &quot; are available. Nothing was added. Lower the number, or raise an Import Request for the model.&quot;</expression>
    </formulas>
    <formulas>
        <name>f_More</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Quantity__c} - 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Sale Vehicle Add Quantity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Sale Vehicle - Add Quantity Of Same Model</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Other_Available</name>
        <label>Get Other Available</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_Others</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Model__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Vehicle__r.Model__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Available</stringValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Vehicle__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Vehicle__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Reserve_Chosen_Car</name>
        <label>Reserve Chosen Car</label>
        <locationX>44</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Add_More</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Vehicle__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Reserved</stringValue>
            </value>
        </inputAssignments>
        <object>Vehicle__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Reset_Line</name>
        <label>Reset Line</label>
        <locationX>44</locationX>
        <locationY>755</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Quantity__c</field>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <object>Sale_Vehicle__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Other_Available</targetReference>
        </connector>
        <filterFormula>AND(ISNEW(), {!$Record.Quantity__c} &gt; 1, NOT(ISBLANK({!$Record.Vehicle__c})))</filterFormula>
        <object>Sale_Vehicle__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Add_More</name>
        <label>Add More</label>
        <locationX>44</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Reset_Line</targetReference>
        </connector>
        <flowName>Add_Fleet_Vehicles_Core</flowName>
        <inputAssignments>
            <name>modelId</name>
            <value>
                <elementReference>$Record.Vehicle__r.Model__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>quantity</name>
            <value>
                <elementReference>f_More</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>var_Others</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
