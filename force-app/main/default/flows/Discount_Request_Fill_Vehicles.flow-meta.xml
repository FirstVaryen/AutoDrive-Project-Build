<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Fill</name>
        <label>Fill</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Vehicles__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_Vehicles</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Copies the vehicles on the sale onto the discount request so approvers see what is being discounted.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_Vehicles</name>
        <dataType>String</dataType>
        <expression>LEFT(IF(ISBLANK({!$Record.Opportunity__r.Fleet_Summary__c}), {!$Record.Opportunity__r.Vehicle__r.Model__r.Name}, SUBSTITUTE({!$Record.Opportunity__r.Fleet_Summary__c}, BR(), &quot;; &quot;)), 255)</expression>
    </formulas>
    <interviewLabel>Discount Request Fill Vehicles {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Discount Request - Fill Vehicles</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Fill</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISBLANK({!$Record.Vehicles__c}))</filterFormula>
        <object>Discount_Request__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
