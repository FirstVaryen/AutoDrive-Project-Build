<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Add_Car</name>
        <label>Add Car</label>
        <locationX>264</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>var_Count</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Car.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_CarName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Car.Chassis_Number__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_Chassis</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Car.Model__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Vehicle_Model__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Car.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Available</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Car.Arrival_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_Cars</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>var_Car</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>More_To_Add</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>More_To_Add</name>
        <label>More To Add?</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Create_Cars</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Done</defaultConnectorLabel>
        <rules>
            <name>Yes_More</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Count</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>f_Quantity</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Car</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>US-38: when an import request is marked Imported, the imported cars (Quantity of the requested type) are added to stock as Available, so the In Stock count every user sees goes up at once.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_CarName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Vehicle_Model__r.Name} &amp; &quot; · &quot; &amp; {!f_Chassis}</expression>
    </formulas>
    <formulas>
        <name>f_Chassis</name>
        <dataType>String</dataType>
        <expression>&quot;IMP-&quot; &amp; {!$Record.Name} &amp; &quot;-&quot; &amp; TEXT({!var_Count})</expression>
    </formulas>
    <formulas>
        <name>f_Quantity</name>
        <dataType>Number</dataType>
        <expression>MAX(1, BLANKVALUE({!$Record.Quantity__c}, 1))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Import Request Add Stock {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Import Request - Add Imported Cars To Stock</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Cars</name>
        <label>Create Cars</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <inputReference>var_Cars</inputReference>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>More_To_Add</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.Status__c}), ISPICKVAL({!$Record.Status__c}, &quot;Imported&quot;), NOT(ISBLANK({!$Record.Vehicle_Model__c})))</filterFormula>
        <object>Import_Request__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_Car</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Vehicle__c</objectType>
    </variables>
    <variables>
        <name>var_Cars</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Vehicle__c</objectType>
    </variables>
    <variables>
        <name>var_Count</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
