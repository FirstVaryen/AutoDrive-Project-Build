<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Stamp</name>
        <label>Stamp</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Signed_Off_By__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_By</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Signed_Off_On__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_On</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>US-29 / NFR-03: when the Head of Finance ticks the sign-off, Signed Off By and Signed Off On are recorded automatically (cleared if the tick is removed). Nobody types them.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_By</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Head_of_Finance_Sign_off__c}, {!$User.Id}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>f_On</name>
        <dataType>Date</dataType>
        <expression>IF({!$Record.Head_of_Finance_Sign_off__c}, TODAY(), NULL)</expression>
    </formulas>
    <interviewLabel>Instalment Plan Stamp Signoff {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Instalment Plan - Stamp Head of Finance Sign-off</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp</targetReference>
        </connector>
        <filterFormula>OR(AND(ISNEW(), {!$Record.Head_of_Finance_Sign_off__c}), ISCHANGED({!$Record.Head_of_Finance_Sign_off__c}))</filterFormula>
        <object>Instalment_Plan__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
