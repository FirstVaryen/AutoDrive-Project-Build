<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Use_Person_Name</name>
        <label>Use Person Name</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignmentItems>
            <assignToReference>$Record.Company</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_FullName</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Salesforce always requires Company on a Lead. For an Individual customer the company is replaced with the person's own name, whatever was typed, so the customer account created at conversion is named after the person. Only Fleet/Corporate leads keep a real company name.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_FullName</name>
        <dataType>String</dataType>
        <expression>TRIM({!$Record.FirstName} &amp; &quot; &quot; &amp; {!$Record.LastName})</expression>
    </formulas>
    <interviewLabel>Lead Individual Company Name {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Lead - Individual Uses Own Name As Company</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Use_Person_Name</targetReference>
        </connector>
        <filterFormula>AND(ISPICKVAL({!$Record.Customer_Type__c}, &quot;Individual&quot;), NOT({!$Record.IsConverted}))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
