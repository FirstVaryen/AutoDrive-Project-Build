<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Auto_Approve</name>
        <label>Auto-approve</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>$Record.Current_Step__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Auto_Approved__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Approved_On__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Send_For_Approval</name>
        <label>Send For Approval</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>$Record.Current_Step__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>With Showroom Manager</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Requester_And_Rate</name>
        <label>Set Requester And Rate</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>$Record.Requested_By__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Requested_Discount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_Rate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Five_Percent_Or_Less</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Five_Percent_Or_Less</name>
        <label>5% Or Less?</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Send_For_Approval</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Above 5%</defaultConnectorLabel>
        <rules>
            <name>Up_To_Five</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_Rate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fx_Rate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Auto_Approve</targetReference>
            </connector>
            <label>5% Or Less</label>
        </rules>
    </decisions>
    <description>Fills in a new discount request: Requested By is the creator; Requested Discount comes from the Discount Rate picked (or, for a fleet sale left blank, the account's agreed rate). Discounts of 5% or less are approved straight away (G4/G5: only above 5% needs sign-off); above 5% starts With Showroom Manager and Discount_Request_Auto_Submit sends it into the approval chain.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_Rate</name>
        <dataType>Number</dataType>
        <expression>IF(
    NOT(ISBLANK(TEXT({!$Record.Discount_Rate__c}))),
    VALUE(SUBSTITUTE(TEXT({!$Record.Discount_Rate__c}), &quot;%&quot;, &quot;&quot;)),
    IF(
        NOT(ISBLANK({!$Record.Requested_Discount__c})),
        {!$Record.Requested_Discount__c},
        {!$Record.Opportunity__r.Account.Agreed_Discount_Rate__c}
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Discount Request Defaults {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Discount Request - Fill In Defaults</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Requester_And_Rate</targetReference>
        </connector>
        <object>Discount_Request__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
