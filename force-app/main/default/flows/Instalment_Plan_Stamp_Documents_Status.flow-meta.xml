<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Stamp_Status_Changed</name>
        <label>Stamp Status Changed</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignmentItems>
            <assignToReference>$Record.Ownership_Documents_Status_Changed__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Stamps Ownership_Documents_Status_Changed__c whenever Ownership Documents Status is set or changes, so reports can show how long documents have been outstanding (KAN-100).</description>
    <environments>Default</environments>
    <interviewLabel>Instalment Plan Stamp Documents Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Instalment Plan - Stamp Documents Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Stamp_Status_Changed</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK(TEXT({!$Record.Ownership_Documents_Status__c}))), OR(ISNEW(), ISCHANGED({!$Record.Ownership_Documents_Status__c})))</filterFormula>
        <object>Instalment_Plan__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
