<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <actionCalls>
        <name>Notify_Finance</name>
        <label>Notify Finance</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Label.AD_Email_Finance</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Approved discount cancelled: sale switched to instalments</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>var_EmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>CurrentUser</stringValue>
            </value>
        </inputParameters>
    </actionCalls>
    <decisions>
        <name>Approved_Discount_Found</name>
        <label>Approved Discount Found?</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Approved_Discounts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invalidate_Discounts</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>KAN-92 (Q-O09): when a sale's Payment Mode changes from Full Payment to Instalment after a discount was approved, the approval no longer holds. Marks every Approved Discount Request on the sale as Invalidated and emails the Finance Team so they can reassess separately.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_FullDeposit</name>
        <dataType>Currency</dataType>
        <expression>ROUND(0.3 * {!$Record.List_Price__c}, 2)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Opportunity Discount Invalidation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Opportunity - Invalidate Discount on Instalment Switch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Approved_Discounts</name>
        <label>Get Approved Discounts</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Approved_Discount_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Current_Step__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Discount_Request__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Restore_Full_Price</name>
        <label>Restore Full Price</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <connector>
            <targetReference>Notify_Finance</targetReference>
        </connector>
        <inputAssignments>
            <field>Sale_Price__c</field>
            <value>
                <elementReference>$Record.List_Price__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Instalment_Down_Payment__c</field>
            <value>
                <elementReference>f_FullDeposit</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Discount_Amount__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Invalidate_Discounts</name>
        <label>Invalidate Discounts</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Restore_Full_Price</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Current_Step__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Current_Step__c</field>
            <value>
                <stringValue>Invalidated</stringValue>
            </value>
        </inputAssignments>
        <object>Discount_Request__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Approved_Discounts</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.Payment_Mode__c}), ISPICKVAL({!$Record.Payment_Mode__c}, &quot;Instalment&quot;), ISPICKVAL(PRIORVALUE({!$Record.Payment_Mode__c}), &quot;Full Payment&quot;))</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>var_EmailBody</name>
        <text>The sale &quot;{!$Record.Name}&quot; was switched from Full Payment to Instalment after its discount was approved. The approved discount has been marked Invalidated and needs to be reassessed by Finance before it can apply to the instalment deal.</text>
    </textTemplates>
</Flow>
