<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>Fleet sales: pick a model and a quantity; that many available cars of the model are added to the sale (each with its model's price) and set to Reserved. If stock is short, the user is told how many could not be added so an Import Request can be raised.</description>
    <dynamicChoiceSets>
        <name>dc_Models</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Vehicle_Model__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>f_Message</name>
        <dataType>String</dataType>
        <expression>IF({!var_Count} = {!Quantity},
  &quot;Added &quot; &amp; TEXT({!var_Count}) &amp; &quot; vehicle(s) to this sale and reserved them.&quot;,
  &quot;Only &quot; &amp; TEXT({!var_Count}) &amp; &quot; of &quot; &amp; TEXT({!Quantity}) &amp; &quot; are available, so &quot; &amp; TEXT({!var_Count}) &amp; &quot; were added and reserved. For the other &quot; &amp; TEXT({!Quantity} - {!var_Count}) &amp; &quot;, raise an Import Request for this model.&quot;)</expression>
    </formulas>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <interviewLabel>Add Fleet Vehicles {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Add Fleet Vehicles</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Pick</name>
        <label>Pick Model and Quantity</label>
        <locationX>176</locationX>
        <locationY>215</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Add_Cars</targetReference>
        </connector>
        <fields>
            <name>Model</name>
            <choiceReferences>dc_Models</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Model</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Quantity</name>
            <dataType>Number</dataType>
            <fieldText>How many</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>0</scale>
            <validationRule>
                <errorMessage>&lt;p&gt;Enter a number from 1 to 50.&lt;/p&gt;</errorMessage>
                <formulaExpression>AND({!Quantity} &gt;= 1, {!Quantity} &lt;= 50)</formulaExpression>
            </validationRule>
        </fields>
        <nextOrFinishButtonLabel>Add vehicles</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Result</name>
        <label>Result</label>
        <locationX>176</locationX>
        <locationY>1079</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Result_Text</name>
            <fieldText>&lt;p&gt;{!f_Message}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Pick</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Add_Cars</name>
        <label>Add Cars</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <connector>
            <targetReference>Result</targetReference>
        </connector>
        <flowName>Add_Fleet_Vehicles_Core</flowName>
        <inputAssignments>
            <name>modelId</name>
            <value>
                <elementReference>Model</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>quantity</name>
            <value>
                <elementReference>Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>var_Count</assignToReference>
            <name>var_Count</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>var_Count</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
