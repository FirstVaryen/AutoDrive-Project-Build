            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Enquiry_Details</name>
        <label>Enquiry Details</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_Lead_Record_Type</targetReference>
        </connector>
        <fields>
            <name>Intro</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Tell us which vehicle you are interested in and how to reach you. A member of our sales team will contact you, usually the same working day.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>First_Name</name>
            <dataType>String</dataType>
            <fieldText>First name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Last_Name</name>
            <dataType>String</dataType>
            <fieldText>Last name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Email</name>
            <dataType>String</dataType>
            <fieldText>Email</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;Please enter a valid email address.&lt;/p&gt;</errorMessage>
                <formulaExpression>OR(ISBLANK({!Email}), REGEX({!Email}, &quot;[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}&quot;))</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Phone</name>
            <dataType>String</dataType>
            <fieldText>Phone</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;We need an email or a phone number so we can reach you.&lt;/p&gt;</helpText>
            <isRequired>false</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;Please give us an email address or a phone number.&lt;/p&gt;</errorMessage>
                <formulaExpression>OR(NOT(ISBLANK({!Phone})), NOT(ISBLANK({!Email})))</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>Customer_Type</name>
            <choiceReferences>ch_Individual</choiceReferences>
            <choiceReferences>ch_Fleet</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>ch_Individual</defaultSelectedChoiceReference>
            <fieldText>I am buying for</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Company</name>
            <dataType>String</dataType>
            <fieldText>Company name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Customer_Type</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Fleet/Corporate</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Vehicle_Model</name>
            <choiceReferences>dc_Models</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Vehicle you are interested in</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Visit_Purpose</name>
            <choiceReferences>ch_Enquiry</choiceReferences>
            <choiceReferences>ch_Purchase</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>ch_Enquiry</defaultSelectedChoiceReference>
            <fieldText>Where are you in your search?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Preferred_Visit_Date</name>
            <dataType>Date</dataType>
            <fieldText>Preferred showroom visit date (optional)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <validationRule>
                <errorMessage>&lt;p&gt;Please choose today or a later date.&lt;/p&gt;</errorMessage>
                <formulaExpression>OR(ISBLANK({!Preferred_Visit_Date}), {!Preferred_Visit_Date} &gt;= TODAY())</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>City</name>
            <dataType>String</dataType>
            <fieldText>City</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>State</name>
            <dataType>String</dataType>
            <fieldText>State</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>How_Heard</name>
            <choiceReferences>ch_Heard_Instagram</choiceReferences>
            <choiceReferences>ch_Heard_Friend</choiceReferences>
            <choiceReferences>ch_Heard_Search</choiceReferences>
            <choiceReferences>ch_Heard_Showroom</choiceReferences>
            <choiceReferences>ch_Heard_Other</choiceReferences>
            <dataType>String</dataType>
            <fieldText>How did you hear about us? (optional)</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Message</name>
            <fieldText>Anything else we should know? (optional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Send enquiry</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Thank_You</name>
        <label>Thank You</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Thanks_Text</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 18px;&quot;&gt;Thank you, {!First_Name}.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;We have your enquiry. A member of our sales team will contact you shortly to talk about the vehicle and arrange a visit.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel>
        <showFooter>false</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Enquiry_Details</targetReference>
        </connector>
    </start>
    <status>Active</status>
</Flow>
