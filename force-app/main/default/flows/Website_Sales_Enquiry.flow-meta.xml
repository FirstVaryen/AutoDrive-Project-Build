    <description>Website Sales Enquiry form (Experience Cloud, guest). Creates an AutoDrive Lead with Channel = Web, owned by the AD Website Leads queue, where Omni-Channel offers it to an available Sales Rep (US-30, US-11). Runs in system mode so the guest user needs no record access; it can only create this one lead and read model names.</description>
    <dynamicChoiceSets>
        <name>dc_Models</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Vehicle_Model__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>f_Company</name>
        <dataType>String</dataType>
        <expression>IF(AND({!Customer_Type} = &quot;Fleet/Corporate&quot;, NOT(ISBLANK({!Company}))), {!Company}, TRIM({!First_Name} &amp; &quot; &quot; &amp; {!Last_Name}))</expression>
    </formulas>
    <formulas>
        <name>f_Description</name>
        <dataType>String</dataType>
        <expression>&quot;Submitted on the website.&quot; &amp; IF(ISBLANK({!Preferred_Visit_Date}), &quot;&quot;, BR() &amp; &quot;Preferred visit date: &quot; &amp; TEXT({!Preferred_Visit_Date})) &amp; IF(ISBLANK({!Message}), &quot;&quot;, BR() &amp; &quot;Message: &quot; &amp; {!Message})</expression>
    </formulas>
    <formulas>
        <name>f_Qualification</name>
        <dataType>String</dataType>
        <expression>&quot;How did you hear about us: &quot; &amp; IF(ISBLANK({!How_Heard}), &quot;not answered&quot;, {!How_Heard})</expression>
    </formulas>
    <interviewLabel>Website Sales Enquiry {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Website - Sales Enquiry</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
