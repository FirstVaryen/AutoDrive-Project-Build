<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>When a plan is created or the Head of Finance sign-off changes, the plan's status is worked out again (Awaiting Sign-off until signed, then Active, Late and so on).</description>
    <environments>Default</environments>
    <interviewLabel>Instalment Plan Status From Signoff {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Instalment Plan - Status From Sign-off</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Recalculate</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.Head_of_Finance_Sign_off__c}))</filterFormula>
        <object>Instalment_Plan__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Recalculate</name>
        <label>Recalculate</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <flowName>Instalment_Plan_Recalculate_Status</flowName>
        <inputAssignments>
            <name>planId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
