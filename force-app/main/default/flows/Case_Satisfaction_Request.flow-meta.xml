<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>On case close, emails the customer's contact once asking for a 1-10 score and stamps CSAT_Requested_At__c. Skipped when the case has no Account or the contact has no email, so closing such a case never fails.</description>
    <environments>Default</environments>
    <interviewLabel>AM Case Satisfaction Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Case - Satisfaction Request</label>
    <processType>AutoLaunchedFlow</processType>

    <actionCalls>
        <name>Send_Satisfaction_Request</name>
        <label>Send Satisfaction Request</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Mark_Requested</targetReference>
        </connector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_Primary_Contact.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>How did we do?</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Your case has been resolved. We would love to hear how we did - please reply with a score from 1 (poor) to 10 (excellent).</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>CurrentUser</stringValue>
            </value>
        </inputParameters>
    </actionCalls>

    <decisions>
        <name>Check_Not_Already_Requested</name>
        <label>Not Already Requested?</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>Already Requested</defaultConnectorLabel>
        <rules>
            <name>Never_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CSAT_Requested_At__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Primary_Contact</targetReference>
            </connector>
            <label>Never Requested</label>
        </rules>
    </decisions>
    <decisions>
        <name>Contact_Has_Email</name>
        <label>Contact Has Email?</label>
        <locationX>176</locationX>
        <locationY>275</locationY>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Has_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Primary_Contact.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Satisfaction_Request</targetReference>
            </connector>
            <label>Has Email</label>
        </rules>
    </decisions>

    <recordLookups>
        <name>Get_Primary_Contact</name>
        <label>Get Primary Contact</label>
        <locationX>176</locationX>
        <locationY>250</locationY>
        <connector>
            <targetReference>Contact_Has_Email</targetReference>
        </connector>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
    </recordLookups>

    <recordUpdates>
        <name>Mark_Requested</name>
        <label>Mark Requested</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>CSAT_Requested_At__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <connector>
            <targetReference>Check_Not_Already_Requested</targetReference>
        </connector>
    </start>
    <status>Active</status>
</Flow>
