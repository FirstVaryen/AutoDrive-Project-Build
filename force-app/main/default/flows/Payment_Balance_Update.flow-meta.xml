<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <description>When a Payment is recorded against an Instalment, recalculates that Instalment's Amount_Paid__c. The Opportunity total needs no flow: Opportunity.Total_Paid__c is a roll-up summary of Payment amounts (an earlier version tried to write it and failed every payment insert).</description>
    <environments>Default</environments>
    <interviewLabel>AM Payment Balance Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AM Payment - Update Balances</label>
    <processType>AutoLaunchedFlow</processType>

    <assignments>
        <name>Add_To_Inst_Total</name>
        <label>Add To Instalment Total</label>
        <locationX>50</locationX>
        <locationY>914</locationY>
        <assignmentItems>
            <assignToReference>var_InstTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Instalment_Payments.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Instalment_Payments</targetReference>
        </connector>
    </assignments>

    <decisions>
        <name>Check_Instalment</name>
        <label>Instalment Set?</label>
        <locationX>176</locationX>
        <locationY>590</locationY>
        <defaultConnectorLabel>No Instalment</defaultConnectorLabel>
        <rules>
            <name>Has_Instalment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Instalment__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Instalment_Payments</targetReference>
            </connector>
            <label>Has Instalment</label>
        </rules>
    </decisions>

    <loops>
        <name>Loop_Instalment_Payments</name>
        <label>Loop Instalment Payments</label>
        <locationX>50</locationX>
        <locationY>806</locationY>
        <collectionReference>Get_Instalment_Payments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_To_Inst_Total</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Instalment_Paid</targetReference>
        </noMoreValuesConnector>
    </loops>

    <recordLookups>
        <name>Get_Instalment_Payments</name>
        <label>Get Instalment Payments</label>
        <locationX>50</locationX>
        <locationY>698</locationY>
        <connector>
            <targetReference>Loop_Instalment_Payments</targetReference>
        </connector>
        <object>Payment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Instalment__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Instalment__c</elementReference>
            </value>
        </filters>
    </recordLookups>

    <recordUpdates>
        <name>Update_Instalment_Paid</name>
        <label>Update Instalment Amount Paid</label>
        <locationX>50</locationX>
        <locationY>1022</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Instalment__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Amount_Paid__c</field>
            <value>
                <elementReference>var_InstTotal</elementReference>
            </value>
        </inputAssignments>
        <object>Instalment__c</object>
    </recordUpdates>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <object>Payment__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector>
            <targetReference>Check_Instalment</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <variables>
        <name>var_InstTotal</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
